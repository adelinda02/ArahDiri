{
  "$schema": "https://unpkg.com/release-it@18/schema/release-it.json",
  "npm": {
    "publish": false
  },
  "git": {
    "requireBranch": "ci-*",
    "requireCleanWorkingDir": true,
    "requireUpstream": true,
    "requireCommits": true,
    "tagName": "v${version}",
    "commit": true,
    "commitMessage": "Release ${version}",
    "push": true
  }
}
